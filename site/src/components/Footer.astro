---
// Starlight's own footer, then the LRCLIB credit and the Plex disclaimer on every page.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>
<div class="plyrix-credits">
  <p>
    The lyrics come from LRCLIB and its contributors. <a href="https://github.com/tranxuanthang/lrclib">LRCLIB</a>
    is MIT licensed; plyrix never bundles or mirrors the dump.
  </p>
  <p>plyrix is an independent project, not affiliated with or endorsed by Plex, Inc.</p>
</div>

<style>
  .plyrix-credits {
    margin-top: 2rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .plyrix-credits p {
    margin: 0.25rem 0;
  }
</style>
